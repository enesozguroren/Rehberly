{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/Profile/{**catch-all}"
        }
      },
      "route-service-route": {
        "ClusterId": "route-cluster",
        "Match": {
          "Path": "/api/Route/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5229"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5068"
          }
        }
      },
      "route-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5190"
          }
        }
      }
    }
  }
}
